<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>cn.dpin.backend</string>
  <key>ProgramArguments</key><array><string>/ABSOLUTE/DPIN/DEPLOY/dpin</string></array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/DPIN/PROJECT</string>
  <key>EnvironmentVariables</key><dict>
    <key>DPIN_RESUME_ARCHIVE_CONFIG</key><string>/ABSOLUTE/DPIN/DEPLOY/config/resume-archive.json</string>
    <key>PATH</key><string>/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/ABSOLUTE/DPIN/DEPLOY/dpin.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/DPIN/DEPLOY/dpin-error.log</string>
</dict></plist>
